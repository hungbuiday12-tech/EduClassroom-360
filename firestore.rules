rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(uname) {
      return uname is string && uname.size() >= 3 && uname.size() <= 30 && uname.matches('^[a-zA-Z0-9_]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isScoreRange(val) {
      return val is number && val >= 0 && val <= 100;
    }

    // Validation for User entity
    function isValidUser(data) {
      return data.keys().hasAll(['username', 'email', 'role']) &&
             data.keys().hasOnly(['username', 'displayName', 'email', 'avatarUrl', 'xp', 'role', 'createdAt', 'updatedAt']) &&
             isValidUsername(data.username) &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['student', 'teacher'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
             (!('xp' in data) || data.xp is number);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().role == 'student';
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().role == existing().role &&
                       incoming().username == existing().username &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'xp', 'updatedAt']);
      allow delete: if false;
    }

    // Validation for StudyProgress entity
    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'itemType', 'itemId']) &&
             data.keys().hasOnly(['userId', 'itemType', 'itemId', 'earnedXp', 'completedAt']) &&
             data.userId == request.auth.uid &&
             data.itemType in ['exam', 'lab_physics', 'lab_math', 'code_judge'] &&
             data.itemId is string && data.itemId.size() <= 128 &&
             (!('earnedXp' in data) || data.earnedXp is number);
    }

    // StudyProgress Collection
    match /study_progress/{progressId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(progressId) &&
                       isValidProgress(incoming());
      allow update: if isSignedIn() &&
                       isValidId(progressId) &&
                       existing().userId == request.auth.uid &&
                       isValidProgress(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Validation for StudyRoadmap entity
    function isValidRoadmap(data) {
      return data.keys().hasAll(['userId', 'completedNodeIds']) &&
             data.keys().hasOnly(['userId', 'completedNodeIds', 'currentStage', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.completedNodeIds is list &&
             data.completedNodeIds.size() <= 100 &&
             (data.completedNodeIds.size() == 0 || (data.completedNodeIds[0] is string && data.completedNodeIds[0].size() <= 64)) &&
             (!('currentStage' in data) || (data.currentStage is string && data.currentStage.size() <= 32)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // StudyRoadmap Collection (per-user procedural mastery state)
    match /study_roadmap/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidRoadmap(incoming());
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidRoadmap(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['completedNodeIds', 'currentStage', 'updatedAt']);
      allow delete: if false;
    }

    // Validation for ArenaAttempt entity (immutable 1-attempt-per-day-per-subject)
    function isValidArenaAttempt(data) {
      return data.keys().hasAll(['userId', 'weekId', 'dateKey', 'subject', 'mode', 'score', 'durationSec']) &&
             data.keys().hasOnly(['userId', 'username', 'displayName', 'weekId', 'dateKey', 'subject', 'mode', 'score', 'correctCount', 'totalQuestions', 'durationSec', 'summary', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.weekId is string && data.weekId.size() >= 4 && data.weekId.size() <= 16 &&
             data.dateKey is string && data.dateKey.size() == 10 &&
             data.subject in ['math', 'physics', 'cs'] &&
             data.mode in ['mcq', 'essay'] &&
             isScoreRange(data.score) &&
             data.durationSec is number && data.durationSec >= 0 && data.durationSec <= 7200 &&
             (!('username' in data) || (data.username is string && data.username.size() <= 40)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // ArenaAttempts Collection (strict owner read/create, zero updates/deletes)
    match /arena_attempts/{attemptId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(attemptId) &&
                       isValidArenaAttempt(incoming());
      allow update: if false;
      allow delete: if false;
    }

    // Validation for WeeklyLeaderboardEntry entity (zero PII)
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'displayName', 'weekId', 'overallAvg', 'totalAttempts']) &&
             data.keys().hasOnly([
               'userId', 'username', 'displayName', 'weekId',
               'mathBest', 'mathAvg', 'mathAttempts',
               'physicsBest', 'physicsAvg', 'physicsAttempts',
               'csBest', 'csAvg', 'csAttempts',
               'overallAvg', 'totalAttempts', 'totalTimeSec', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.weekId is string && data.weekId.size() >= 4 && data.weekId.size() <= 16 &&
             isScoreRange(data.overallAvg) &&
             data.totalAttempts is number && data.totalAttempts >= 1 && data.totalAttempts <= 21 &&
             (!('username' in data) || (data.username is string && data.username.size() <= 40)) &&
             (!('mathBest' in data) || data.mathBest == null || isScoreRange(data.mathBest)) &&
             (!('mathAvg' in data) || data.mathAvg == null || isScoreRange(data.mathAvg)) &&
             (!('physicsBest' in data) || data.physicsBest == null || isScoreRange(data.physicsBest)) &&
             (!('physicsAvg' in data) || data.physicsAvg == null || isScoreRange(data.physicsAvg)) &&
             (!('csBest' in data) || data.csBest == null || isScoreRange(data.csBest)) &&
             (!('csAvg' in data) || data.csAvg == null || isScoreRange(data.csAvg));
    }

    // Weekly Leaderboard Collection (public non-PII read scoped to weekId, owner-only write)
    match /weekly_leaderboard/{entryId} {
      allow get: if true;
      allow list: if resource.data.weekId is string;
      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().userId == request.auth.uid;
      allow update: if isSignedIn() &&
                       isValidId(entryId) &&
                       existing().userId == request.auth.uid &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().weekId == existing().weekId &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'username', 'displayName',
                         'mathBest', 'mathAvg', 'mathAttempts',
                         'physicsBest', 'physicsAvg', 'physicsAttempts',
                         'csBest', 'csAvg', 'csAttempts',
                         'overallAvg', 'totalAttempts', 'totalTimeSec', 'updatedAt'
                       ]);
      allow delete: if false;
    }

    // Validation for LessonAssessment entity
    function isValidLessonAssessment(data) {
      return data.keys().hasAll(['userId', 'lessonKey', 'subject', 'lessonTitle', 'mcqCorrect', 'mcqTotal', 'overallMastery']) &&
             data.keys().hasOnly([
               'userId', 'lessonKey', 'subject', 'lessonTitle', 'grade',
               'totalSteps', 'completedSteps', 'mcqCorrect', 'mcqTotal',
               'essayGradedCount', 'essayAvgScore', 'overallMastery',
               'strongStepTitles', 'weakStepTitles', 'readinessLevel', 'recommendedAction', 'updatedAt'
             ]) &&
             data.userId == request.auth.uid &&
             data.lessonKey is string && data.lessonKey.size() > 0 && data.lessonKey.size() <= 128 &&
             data.subject in ['math', 'physics', 'cs'] &&
             data.lessonTitle is string && data.lessonTitle.size() > 0 && data.lessonTitle.size() <= 200 &&
             data.mcqCorrect is number && data.mcqCorrect >= 0 && data.mcqCorrect <= 200 &&
             data.mcqTotal is number && data.mcqTotal >= 0 && data.mcqTotal <= 200 &&
             isScoreRange(data.overallMastery) &&
             (!('grade' in data) || (data.grade is string && data.grade.size() <= 64)) &&
             (!('totalSteps' in data) || (data.totalSteps is number && data.totalSteps >= 0 && data.totalSteps <= 50)) &&
             (!('completedSteps' in data) || (data.completedSteps is number && data.completedSteps >= 0 && data.completedSteps <= 50)) &&
             (!('essayGradedCount' in data) || (data.essayGradedCount is number && data.essayGradedCount >= 0 && data.essayGradedCount <= 50)) &&
             (!('essayAvgScore' in data) || (data.essayAvgScore is number && data.essayAvgScore >= 0 && data.essayAvgScore <= 10)) &&
             (!('strongStepTitles' in data) || (data.strongStepTitles is list && data.strongStepTitles.size() <= 20 && (data.strongStepTitles.size() == 0 || (data.strongStepTitles[0] is string && data.strongStepTitles[0].size() <= 200)))) &&
             (!('weakStepTitles' in data) || (data.weakStepTitles is list && data.weakStepTitles.size() <= 20 && (data.weakStepTitles.size() == 0 || (data.weakStepTitles[0] is string && data.weakStepTitles[0].size() <= 200)))) &&
             (!('readinessLevel' in data) || (data.readinessLevel is string && data.readinessLevel.size() <= 160)) &&
             (!('recommendedAction' in data) || (data.recommendedAction is string && data.recommendedAction.size() <= 400)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // LessonAssessments Collection (strict owner read/write)
    match /lesson_assessments/{assessmentId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(assessmentId) &&
                       isValidLessonAssessment(incoming());
      allow update: if isSignedIn() &&
                       isValidId(assessmentId) &&
                       existing().userId == request.auth.uid &&
                       isValidLessonAssessment(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().lessonKey == existing().lessonKey &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'subject', 'lessonTitle', 'grade',
                         'totalSteps', 'completedSteps', 'mcqCorrect', 'mcqTotal',
                         'essayGradedCount', 'essayAvgScore', 'overallMastery',
                         'strongStepTitles', 'weakStepTitles', 'readinessLevel', 'recommendedAction', 'updatedAt'
                       ]);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Validation for PlatformReview entity (public non-PII read, signed-in create/vote, owner delete)
    function isValidPlatformReview(data) {
      return data.keys().hasAll(['userId', 'displayName', 'rating', 'favoriteCategory', 'comment', 'helpfulCount', 'createdAt']) &&
             data.keys().hasOnly([
               'userId', 'username', 'displayName', 'avatarUrl',
               'rating', 'favoriteCategory', 'comment',
               'helpfulUserIds', 'helpfulCount', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.favoriteCategory in ['simulations', 'lectures_ai', 'coding_exams', 'interface', 'general'] &&
             data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 800 &&
             data.helpfulCount is number && data.helpfulCount >= 0 && data.helpfulCount <= 50000 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('username' in data) || (data.username is string && data.username.size() <= 40)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
             (!('helpfulUserIds' in data) || (data.helpfulUserIds is list && data.helpfulUserIds.size() <= 500)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // PlatformReviews Collection (public read for all users, signed-in create/helpful vote, owner delete)
    match /platform_reviews/{reviewId} {
      allow get: if true;
      allow list: if resource.data.rating >= 1 && resource.data.rating <= 5;
      allow create: if isSignedIn() &&
                       isValidId(reviewId) &&
                       isValidPlatformReview(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().helpfulCount == 0;
      allow update: if isSignedIn() &&
                       isValidId(reviewId) &&
                       isValidPlatformReview(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().userId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'favoriteCategory', 'comment', 'updatedAt'])) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['helpfulUserIds', 'helpfulCount', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    function isForumAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             (
               request.auth.token.email == 'synapse.admin@educlassroom360.vn' ||
               exists(/databases/$(database)/documents/admins/$(request.auth.uid))
             );
    }

    function isValidForumGroup(data) {
      return data.keys().hasAll(['name', 'description', 'subject', 'isMandatoryAdminGroup', 'creatorId', 'creatorName', 'messageCount', 'createdAt']) &&
             data.keys().hasOnly([
               'name', 'description', 'subject', 'isMandatoryAdminGroup',
               'creatorId', 'creatorName', 'creatorUsername',
               'messageCount', 'lastMessagePreview', 'lastMessageAt', 'createdAt'
             ]) &&
             data.name is string && data.name.size() >= 3 && data.name.size() <= 80 &&
             data.description is string && data.description.size() >= 3 && data.description.size() <= 300 &&
             data.subject in ['announcements', 'general', 'math', 'physics', 'chemistry', 'biology', 'cs', 'exams'] &&
             data.isMandatoryAdminGroup is bool &&
             data.creatorId is string && data.creatorId.size() > 0 && data.creatorId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 100 &&
             data.messageCount is number && data.messageCount >= 0 && data.messageCount <= 1000000 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('creatorUsername' in data) || (data.creatorUsername is string && data.creatorUsername.size() <= 40)) &&
             (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 200)) &&
             (!('lastMessageAt' in data) || (data.lastMessageAt is string && data.lastMessageAt.size() <= 64));
    }

    function isValidForumMessage(data, groupId) {
      return data.keys().hasAll(['groupId', 'isAdminGroup', 'senderId', 'senderName', 'senderRole', 'content', 'createdAt']) &&
             data.keys().hasOnly([
               'groupId', 'isAdminGroup', 'senderId', 'senderName',
               'senderUsername', 'senderAvatar', 'senderRole', 'content', 'createdAt'
             ]) &&
             data.groupId == groupId &&
             data.isAdminGroup is bool &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
             data.senderRole in ['student', 'teacher', 'admin'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('senderUsername' in data) || (data.senderUsername is string && data.senderUsername.size() <= 40)) &&
             (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 512));
    }

    // Study Forum Groups (Only signed-in users can create groups or enter the mandatory Admin group)
    match /forum_groups/{groupId} {
      allow get: if isSignedIn() || (existing().isMandatoryAdminGroup == false && groupId != 'official-announcements');
      allow list: if isSignedIn() || resource.data.isMandatoryAdminGroup == false;
      allow create: if isSignedIn() &&
                       request.auth.token.email_verified == true &&
                       isValidId(groupId) &&
                       isValidForumGroup(incoming()) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().messageCount == 0 &&
                       (
                         (!incoming().isMandatoryAdminGroup && groupId != 'official-announcements') ||
                         (isForumAdmin() && groupId == 'official-announcements' && incoming().isMandatoryAdminGroup)
                       );
      allow update: if isSignedIn() &&
                       isValidId(groupId) &&
                       isValidForumGroup(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().isMandatoryAdminGroup == existing().isMandatoryAdminGroup &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         ((existing().creatorId == request.auth.uid || isForumAdmin()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'subject', 'lastMessagePreview', 'lastMessageAt', 'messageCount'])) ||
                         ((!existing().isMandatoryAdminGroup && groupId != 'official-announcements') &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['lastMessagePreview', 'lastMessageAt', 'messageCount']))
                       );
      allow delete: if isSignedIn() &&
                       isValidId(groupId) &&
                       !existing().isMandatoryAdminGroup &&
                       groupId != 'official-announcements' &&
                       (existing().creatorId == request.auth.uid || isForumAdmin());

      // Nested Group Messages (Master Gate checks parent group + Synapse admin-only rule on official-announcements)
      match /messages/{messageId} {
        allow get: if isSignedIn() || existing().isAdminGroup == false;
        allow list: if isSignedIn() || resource.data.isAdminGroup == false;
        allow create: if isSignedIn() &&
                         request.auth.token.email_verified == true &&
                         isValidId(groupId) &&
                         isValidId(messageId) &&
                         isValidForumMessage(incoming(), groupId) &&
                         exists(/databases/$(database)/documents/forum_groups/$(groupId)) &&
                         get(/databases/$(database)/documents/forum_groups/$(groupId)).data.isMandatoryAdminGroup == incoming().isAdminGroup &&
                         (
                           (!incoming().isAdminGroup && groupId != 'official-announcements' && incoming().senderRole != 'admin') ||
                           isForumAdmin()
                         );
        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(groupId) &&
                         isValidId(messageId) &&
                         (
                           (!existing().isAdminGroup && groupId != 'official-announcements' && existing().senderId == request.auth.uid) ||
                           isForumAdmin()
                         );
      }
    }

    function isValidReactionList(reactions, key) {
      return !(key in reactions) || (reactions[key] is list && reactions[key].size() <= 1000);
    }

    function isValidPostReactions(reactions) {
      return reactions is map &&
             reactions.keys().hasOnly(['👍', '❤️', '🔥', '💡']) &&
             isValidReactionList(reactions, '👍') &&
             isValidReactionList(reactions, '❤️') &&
             isValidReactionList(reactions, '🔥') &&
             isValidReactionList(reactions, '💡');
    }

    function isValidPostAttachment(att) {
      return att is map &&
             att.keys().hasAll(['kind', 'subject', 'targetId', 'title']) &&
             att.keys().hasOnly(['kind', 'subject', 'targetId', 'domainId', 'title', 'subtitle', 'formula', 'gradeLabel', 'openSim']) &&
             att.kind in ['lecture', 'sim2d', 'sim3d', 'sandbox', 'pre_lab'] &&
             att.subject in ['math', 'physics', 'chemistry', 'biology', 'cs', 'pre'] &&
             att.targetId is string && att.targetId.size() >= 1 && att.targetId.size() <= 128 &&
             att.title is string && att.title.size() >= 1 && att.title.size() <= 180 &&
             (!('domainId' in att) || (att.domainId is string && att.domainId.size() <= 80)) &&
             (!('subtitle' in att) || (att.subtitle is string && att.subtitle.size() <= 240)) &&
             (!('formula' in att) || (att.formula is string && att.formula.size() <= 240)) &&
             (!('gradeLabel' in att) || (att.gradeLabel is string && att.gradeLabel.size() <= 40)) &&
             (!('openSim' in att) || att.openSim is bool);
    }

    function isValidForumPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'authorRole', 'postType', 'subject', 'content', 'reactions', 'commentsCount', 'createdAt']) &&
             data.keys().hasOnly([
               'authorId', 'authorName', 'authorUsername', 'authorAvatar', 'authorRole',
               'postType', 'subject', 'title', 'content', 'attachment',
               'tags', 'gradeTag', 'reactions', 'commentsCount', 'tryCount',
               'isPinned', 'createdAt', 'updatedAt'
             ]) &&
             data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             data.authorRole in ['student', 'teacher', 'admin'] &&
             data.postType in ['experiment', 'lecture', 'discussion', 'update'] &&
             data.subject in ['announcements', 'general', 'math', 'physics', 'chemistry', 'biology', 'cs', 'exams'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
             isValidPostReactions(data.reactions) &&
             data.commentsCount is number && data.commentsCount >= 0 && data.commentsCount <= 50000 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('authorUsername' in data) || (data.authorUsername is string && data.authorUsername.size() <= 40)) &&
             (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 512)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 160)) &&
             (!('attachment' in data) || isValidPostAttachment(data.attachment)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 5 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 32)))) &&
             (!('gradeTag' in data) || (data.gradeTag is string && data.gradeTag.size() <= 32)) &&
             (!('tryCount' in data) || (data.tryCount is number && data.tryCount >= 0 && data.tryCount <= 1000000)) &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidForumPostComment(data, postId) {
      return data.keys().hasAll(['postId', 'authorId', 'authorName', 'authorRole', 'content', 'createdAt']) &&
             data.keys().hasOnly([
               'postId', 'authorId', 'authorName', 'authorUsername',
               'authorAvatar', 'authorRole', 'content', 'createdAt'
             ]) &&
             data.postId == postId &&
             data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             data.authorRole in ['student', 'teacher', 'admin'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('authorUsername' in data) || (data.authorUsername is string && data.authorUsername.size() <= 40)) &&
             (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 512));
    }

    // Forum Social Feed Posts (public non-PII read, verified signed-in create/react/try, owner edit/delete, Admin Synapse update/pin)
    match /forum_posts/{postId} {
      allow get: if true;
      allow list: if resource.data.postType in ['experiment', 'lecture', 'discussion', 'update'];
      allow create: if isSignedIn() &&
                       request.auth.token.email_verified == true &&
                       isValidId(postId) &&
                       isValidForumPost(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().commentsCount == 0 &&
                       (!('tryCount' in incoming()) || incoming().tryCount == 0) &&
                       (incoming().postType != 'update' || isForumAdmin()) &&
                       (!('isPinned' in incoming()) || incoming().isPinned == false || isForumAdmin()) &&
                       (incoming().authorRole != 'admin' || isForumAdmin());
      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidForumPost(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         ((existing().authorId == request.auth.uid || isForumAdmin()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'postType', 'subject', 'attachment', 'tags', 'gradeTag', 'updatedAt']) &&
                          (incoming().postType != 'update' || isForumAdmin())) ||
                         (isForumAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isPinned', 'updatedAt'])) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'commentsCount', 'tryCount', 'updatedAt']))
                       );
      allow delete: if isSignedIn() &&
                       isValidId(postId) &&
                       (existing().authorId == request.auth.uid || isForumAdmin());

      match /comments/{commentId} {
        allow get: if true;
        allow list: if resource.data.postId == postId;
        allow create: if isSignedIn() &&
                         request.auth.token.email_verified == true &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         isValidForumPostComment(incoming(), postId) &&
                         exists(/databases/$(database)/documents/forum_posts/$(postId)) &&
                         (incoming().authorRole != 'admin' || isForumAdmin());
        allow update: if false;
        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         (
                           existing().authorId == request.auth.uid ||
                           get(/databases/$(database)/documents/forum_posts/$(postId)).data.authorId == request.auth.uid ||
                           isForumAdmin()
                         );
      }
    }
  }
}
