rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(uname) {
      return uname is string && uname.size() >= 3 && uname.size() <= 30 && uname.matches('^[a-zA-Z0-9_]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User entity
    function isValidUser(data) {
      return data.keys().hasAll(['username', 'email', 'role']) &&
             data.keys().hasOnly(['username', 'displayName', 'email', 'avatarUrl', 'xp', 'role', 'createdAt', 'updatedAt']) &&
             isValidUsername(data.username) &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['student', 'teacher'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
             (!('xp' in data) || data.xp is number);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().role == 'student'; // Prevent self-elevation to admin/teacher
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().role == existing().role && // Role is immutable by self
                       incoming().username == existing().username && // Username is immutable
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'xp', 'updatedAt']);
      allow delete: if false;
    }

    // Validation for StudyProgress entity
    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'itemType', 'itemId']) &&
             data.keys().hasOnly(['userId', 'itemType', 'itemId', 'earnedXp', 'completedAt']) &&
             data.userId == request.auth.uid &&
             data.itemType in ['exam', 'lab_physics', 'lab_math', 'code_judge'] &&
             data.itemId is string && data.itemId.size() <= 128 &&
             (!('earnedXp' in data) || data.earnedXp is number);
    }

    // StudyProgress Collection
    match /study_progress/{progressId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(progressId) &&
                       isValidProgress(incoming());
      allow update: if isSignedIn() &&
                       isValidId(progressId) &&
                       existing().userId == request.auth.uid &&
                       isValidProgress(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
