{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and account information",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Unique username chosen by user",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the student or teacher",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of user",
          "maxLength": 128
        },
        "avatarUrl": {
          "type": "string",
          "description": "Avatar photo URL",
          "maxLength": 512
        },
        "xp": {
          "type": "number",
          "description": "Gamified study experience points"
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher", "admin"],
          "description": "User role in platform"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        }
      },
      "required": ["username", "email", "role"]
    },
    "StudyProgress": {
      "title": "StudyProgress",
      "description": "Recorded exam or lab session progress for a student",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128
        },
        "itemType": {
          "type": "string",
          "enum": ["exam", "lab_physics", "lab_math", "code_judge"]
        },
        "itemId": {
          "type": "string",
          "maxLength": 128
        },
        "earnedXp": {
          "type": "number"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "itemType", "itemId"]
    },
    "StudyRoadmap": {
      "title": "StudyRoadmap",
      "description": "Student procedural learning roadmap progress",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "completedNodeIds": {
          "type": "array",
          "description": "Completed procedural node IDs (max 100)"
        },
        "currentStage": {
          "type": "string",
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["userId", "completedNodeIds"]
    },
    "ArenaAttempt": {
      "title": "ArenaAttempt",
      "description": "Daily once-per-subject online competition submission",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "maxLength": 40
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "weekId": {
          "type": "string",
          "maxLength": 16
        },
        "dateKey": {
          "type": "string",
          "maxLength": 16
        },
        "subject": {
          "type": "string",
          "enum": ["math", "physics", "cs"]
        },
        "mode": {
          "type": "string",
          "enum": ["mcq", "essay"]
        },
        "score": {
          "type": "number"
        },
        "durationSec": {
          "type": "number"
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["userId", "weekId", "dateKey", "subject", "mode", "score", "durationSec"]
    },
    "WeeklyLeaderboardEntry": {
      "title": "WeeklyLeaderboardEntry",
      "description": "Public non-PII weekly arena performance entry per subject and average",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "maxLength": 40
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "weekId": {
          "type": "string",
          "maxLength": 16
        },
        "mathBest": { "type": "number" },
        "mathAvg": { "type": "number" },
        "mathAttempts": { "type": "number" },
        "physicsBest": { "type": "number" },
        "physicsAvg": { "type": "number" },
        "physicsAttempts": { "type": "number" },
        "csBest": { "type": "number" },
        "csAvg": { "type": "number" },
        "csAttempts": { "type": "number" },
        "overallAvg": { "type": "number" },
        "totalAttempts": { "type": "number" },
        "totalTimeSec": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "displayName", "weekId", "overallAvg", "totalAttempts"]
    },
    "LessonAssessment": {
      "title": "LessonAssessment",
      "description": "Saved per-lesson lecture assessment summary, mastery score, and roadmap recommendation",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "lessonKey": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "enum": ["math", "physics", "cs"] },
        "lessonTitle": { "type": "string", "maxLength": 200 },
        "grade": { "type": "string", "maxLength": 64 },
        "totalSteps": { "type": "number" },
        "completedSteps": { "type": "number" },
        "mcqCorrect": { "type": "number" },
        "mcqTotal": { "type": "number" },
        "essayGradedCount": { "type": "number" },
        "essayAvgScore": { "type": "number" },
        "overallMastery": { "type": "number" },
        "strongStepTitles": { "type": "array", "description": "Mastered step titles (max 20)" },
        "weakStepTitles": { "type": "array", "description": "Weak step titles needing review (max 20)" },
        "readinessLevel": { "type": "string", "maxLength": 160 },
        "recommendedAction": { "type": "string", "maxLength": 400 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "lessonKey", "subject", "lessonTitle", "mcqCorrect", "mcqTotal", "overallMastery"]
    },
    "PlatformReview": {
      "title": "PlatformReview",
      "description": "Public user review, star rating, and helpful vote counter for the platform",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 40 },
        "displayName": { "type": "string", "maxLength": 100 },
        "avatarUrl": { "type": "string", "maxLength": 512 },
        "rating": { "type": "number" },
        "favoriteCategory": {
          "type": "string",
          "enum": ["simulations", "lectures_ai", "coding_exams", "interface", "general"]
        },
        "comment": { "type": "string", "maxLength": 800 },
        "helpfulUserIds": {
          "type": "array",
          "description": "List of user IDs who upvoted this review (max 500)"
        },
        "helpfulCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "displayName", "rating", "favoriteCategory", "comment", "helpfulCount", "createdAt"]
    },
    "ForumGroup": {
      "title": "ForumGroup",
      "description": "Study forum discussion group or the mandatory admin announcement group",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 80 },
        "description": { "type": "string", "minLength": 3, "maxLength": 300 },
        "subject": {
          "type": "string",
          "enum": ["announcements", "general", "math", "physics", "cs", "exams"]
        },
        "isMandatoryAdminGroup": { "type": "boolean" },
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 100 },
        "creatorUsername": { "type": "string", "maxLength": 40 },
        "messageCount": { "type": "number" },
        "lastMessagePreview": { "type": "string", "maxLength": 200 },
        "lastMessageAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "description", "subject", "isMandatoryAdminGroup", "creatorId", "creatorName", "messageCount", "createdAt"]
    },
    "ForumMessage": {
      "title": "ForumMessage",
      "description": "Message inside a study forum group",
      "type": "object",
      "properties": {
        "groupId": { "type": "string", "maxLength": 128 },
        "isAdminGroup": { "type": "boolean" },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderUsername": { "type": "string", "maxLength": 40 },
        "senderAvatar": { "type": "string", "maxLength": 512 },
        "senderRole": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["groupId", "isAdminGroup", "senderId", "senderName", "senderRole", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles with access restricted to the user"
    },
    "/study_progress/{progressId}": {
      "schema": "StudyProgress",
      "description": "Stores completion records and XP logs of students"
    },
    "/study_roadmap/{userId}": {
      "schema": "StudyRoadmap",
      "description": "Stores completed procedural learning roadmap nodes for each student"
    },
    "/arena_attempts/{attemptId}": {
      "schema": "ArenaAttempt",
      "description": "Immutable daily competition attempt keyed by uid_dateKey_subject"
    },
    "/weekly_leaderboard/{entryId}": {
      "schema": "WeeklyLeaderboardEntry",
      "description": "Weekly leaderboard metrics keyed by weekId_uid"
    },
    "/lesson_assessments/{assessmentId}": {
      "schema": "LessonAssessment",
      "description": "Per-student saved lecture quiz & mini-essay progress and roadmap analysis"
    },
    "/platform_reviews/{reviewId}": {
      "schema": "PlatformReview",
      "description": "Public user reviews, star ratings, favorite votes, and comments"
    },
    "/forum_groups/{groupId}": {
      "schema": "ForumGroup",
      "description": "Study forum discussion groups plus mandatory official announcement group managed by Admin Synapse"
    },
    "/forum_groups/{groupId}/messages/{messageId}": {
      "schema": "ForumMessage",
      "description": "Chat and announcement messages nested under each forum group"
    }
  }
}
